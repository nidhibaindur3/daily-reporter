# Local PostgreSQL configuration. Copy this file to .env and replace the
# placeholder password before starting the database. Hosted environments can
# set a single DATABASE_URL instead; it takes precedence over these values.
# DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_USER=daily_digest
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=daily_digest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend configuration
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Market data configuration. Create a Finnhub API key and keep it only in the
# backend environment. The browser never calls Finnhub directly.
MARKET_WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN
MARKET_EXCHANGE=US
MARKET_API_BASE_URL=https://finnhub.io/api/v1
MARKET_REQUEST_TIMEOUT_SECONDS=5
MARKET_CACHE_TTL_SECONDS=300
MARKET_STALE_TTL_SECONDS=1800
FINNHUB_API_KEY=

# News feed configuration. Sources are a reviewed backend catalog; no API key is
# required. Only feed metadata and short publisher-provided excerpts are read.
NEWS_ARTICLES_PER_CATEGORY=6
NEWS_REQUEST_TIMEOUT_SECONDS=8
NEWS_MAXIMUM_FEED_BYTES=1000000
NEWS_CACHE_TTL_SECONDS=900
NEWS_STALE_TTL_SECONDS=10800

# Research AI configuration. This credential is backend-only. Research
# discovery is disabled until OPENAI_API_KEY is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_REASONING_EFFORT=minimal
OPENAI_VERBOSITY=low
# Research Discovery uses the same backend-only model credential. The API
# enqueues durable work; a separate worker runs the modular evidence pipeline.
MARKET_INTELLIGENCE_SOURCE_LIMIT=24
MARKET_INTELLIGENCE_MAXIMUM_THEMES=3
MARKET_INTELLIGENCE_MAX_OUTPUT_TOKENS=3500
MARKET_INTELLIGENCE_WORKER_POLL_SECONDS=5
MARKET_INTELLIGENCE_JOB_LEASE_SECONDS=600
MARKET_INTELLIGENCE_JOB_RETRY_SECONDS=30
